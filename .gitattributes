* text=auto

# Shell-Skripte MÜSSEN LF haben: mit CRLF bricht bash mit
# "syntax error: unexpected end of file" ab und das AppImage-AppRun startet nicht.
*.sh        text eol=lf
AppRun      text eol=lf
*.desktop   text eol=lf

# PowerShell darf CRLF behalten.
*.ps1       text eol=crlf

*.png       binary
*.ico       binary
