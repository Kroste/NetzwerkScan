<Project>
  <!-- Kroste-Standard: gemeinsame Build-Einstellungen für alle Projekte im Repo -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>Lars Oste</Authors>
    <RepositoryUrl>https://github.com/Kroste/NetzwerkScan</RepositoryUrl>
    <!-- MinVer: Version aus Git-Tags (v*) statt einer handgepflegten <Version> -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
</Project>
