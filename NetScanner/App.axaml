<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetScanner.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <!-- ================================================================== -->
    <!-- Kroste-Palette (verbindlich, siehe kroste-avalonia/references/design.md) -->
    <!-- ================================================================== -->
    <SolidColorBrush x:Key="KrosteBackgroundBrush"   Color="#1A1D21" />
    <SolidColorBrush x:Key="KrosteTitleBarBrush"     Color="#14161A" />
    <SolidColorBrush x:Key="KrosteSurfaceBrush"      Color="#22262B" />
    <SolidColorBrush x:Key="KrosteCardBrush"         Color="#1F2328" />
    <SolidColorBrush x:Key="KrosteAccentBrush"       Color="#123E6B" />
    <SolidColorBrush x:Key="KrosteAccentHoverBrush"  Color="#1B5390" />
    <SolidColorBrush x:Key="KrosteAccentSoftBrush"   Color="#1E3A5C" />
    <SolidColorBrush x:Key="KrosteGoldBrush"         Color="#E0B14C" />
    <SolidColorBrush x:Key="KrosteBorderBrush"       Color="#2E343C" />
    <SolidColorBrush x:Key="KrosteBorderStrongBrush" Color="#3C444E" />
    <SolidColorBrush x:Key="KrosteMutedTextBrush"    Color="#8A93A0" />
    <SolidColorBrush x:Key="KrosteSecondaryTextBrush" Color="#B7BEC7" />
    <SolidColorBrush x:Key="KrosteTextBrush"         Color="#E4E7EC" />
    <SolidColorBrush x:Key="KrosteDangerBrush"       Color="#C42B1C" />
    <SolidColorBrush x:Key="KrosteSuccessBrush"      Color="#3AA55B" />

    <!-- ================================================================== -->
    <!-- Projektspezifische Semantik-Farben (Status im Scan-Ergebnis).        -->
    <!-- Bewusst NICHT Teil der Kroste-Palette: sie kodieren einen Zustand,   -->
    <!-- keine UI-Rolle, und müssen sich deshalb voneinander abheben.         -->
    <!-- ================================================================== -->
    <SolidColorBrush x:Key="NetOnlineBrush"     Color="#3AA55B" />   <!-- Host antwortet -->
    <SolidColorBrush x:Key="NetArpOnlyBrush"    Color="#D9A441" />   <!-- nur per ARP gesehen -->
    <SolidColorBrush x:Key="NetCameraBrush"     Color="#F0883E" />   <!-- Kamera erkannt -->
    <SolidColorBrush x:Key="NetCameraSoftBrush" Color="#3A2A1C" />
    <SolidColorBrush x:Key="NetCoffeeBrush"     Color="#FFDD00" />   <!-- Buy me a coffee -->
    <SolidColorBrush x:Key="NetVulnBrush"       Color="#E74C3C" />   <!-- Audit-Fund -->
    <SolidColorBrush x:Key="NetVulnSoftBrush"   Color="#3A1414" />
    <SolidColorBrush x:Key="NetVulnBorderBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="NetVideoBackgroundBrush" Color="#05080B" />   <!-- Letterbox hinter dem Stream -->
    <SolidColorBrush x:Key="NetSuccessSoftBrush"   Color="#14271A" />   <!-- Entwarnung (nichts exponiert) -->
    <SolidColorBrush x:Key="NetSuccessBorderBrush" Color="#2E7D46" />
    <SolidColorBrush x:Key="NetSuccessTextBrush"   Color="#4ADE80" />

    <!-- Netzwerkkarte: Knotenfarben nach Gerätekategorie. Sie müssen sich
         voneinander unterscheiden lassen, deshalb eine eigene Reihe. -->
    <SolidColorBrush x:Key="NetNodeLinkBrush"   Color="#3A4752" />   <!-- Verbindungslinien -->
    <SolidColorBrush x:Key="NetNodeBlueBrush"   Color="#378ADD" />
    <SolidColorBrush x:Key="NetNodeGreenBrush"  Color="#7BB661" />
    <SolidColorBrush x:Key="NetNodePurpleBrush" Color="#8E86E0" />
    <SolidColorBrush x:Key="NetNodeAmberBrush"  Color="#D9A441" />
    <SolidColorBrush x:Key="NetNodePinkBrush"   Color="#D4789E" />

    <!-- Passwortstärke: fünfstufige Ampel von rot nach grün. -->
    <SolidColorBrush x:Key="NetStrength0Brush" Color="#E74C3C" />
    <SolidColorBrush x:Key="NetStrength1Brush" Color="#F0883E" />
    <SolidColorBrush x:Key="NetStrength2Brush" Color="#FFDD00" />
    <SolidColorBrush x:Key="NetStrength3Brush" Color="#9ACD32" />
    <SolidColorBrush x:Key="NetStrength4Brush" Color="#4ADE80" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- ================================================================== -->
    <!-- Titelleiste (Kroste-Chrome-Standard)                                -->
    <!-- ================================================================== -->
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource KrosteMutedTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2A2E33" />
    </Style>
    <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KrosteDangerBrush}" />
    </Style>

    <!-- ================================================================== -->
    <!-- Buttons — konsistenter Basis-Look, Varianten via Klasse             -->
    <!-- ================================================================== -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource KrosteTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2A2F36" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderStrongBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#181B20" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Primäre Aktion. Der Akzent MUSS direkt am ContentPresenter gesetzt werden:
         FluentTheme hat eine eingebaute Button.accent-Klasse (System-Akzent), die
         einen Setter auf Button.Background überstimmt. -->
    <Style Selector="Button.accent">
      <Setter Property="Foreground" Value="#F5F7FA" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KrosteAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteAccentBrush}" />
      <Setter Property="Foreground" Value="#F5F7FA" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KrosteAccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KrosteBorderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource KrosteMutedTextBrush}" />
    </Style>

    <!-- Ghost: rein textlich, Hover bekommt subtiles Card-Background. -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource KrosteSecondaryTextBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2A2F36" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Gefährliche Aktion (löschen/verwerfen): roter Hover-State. -->
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#5A1F19" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteDangerBrush}" />
    </Style>

    <!-- Runder Icon-Button in der Titelleiste (Karte, Passwort-Check, Über …). -->
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{DynamicResource KrosteCardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource KrosteMutedTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteGoldBrush}" />
    </Style>

    <!-- Kamera-Stream öffnen: eigener Semantik-Akzent, damit die Aktion in der
         Host-Karte sofort als "hier ist Video" lesbar ist. -->
    <Style Selector="Button.stream">
      <Setter Property="Background" Value="{DynamicResource NetCameraSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NetCameraBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NetCameraSoftBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.stream:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NetCameraBrush}" />
      <Setter Property="Foreground" Value="#1A0E04" />
      <Setter Property="BorderBrush" Value="{DynamicResource NetCameraBrush}" />
    </Style>

    <!-- Buy-me-a-coffee (AboutWindow) -->
    <Style Selector="Button.coffee">
      <Setter Property="Background" Value="{DynamicResource NetCoffeeBrush}" />
      <Setter Property="Foreground" Value="#231F00" />
      <Setter Property="BorderBrush" Value="{DynamicResource NetCoffeeBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.coffee:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFE740" />
      <Setter Property="Foreground" Value="#231F00" />
      <Setter Property="BorderBrush" Value="#FFE740" />
    </Style>

    <!-- Link-Button: sieht aus wie ein Link, verhält sich wie ein Button. -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource KrosteGoldBrush}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>

    <!-- Filter-Chip: RadioButton als Segment-Schalter (Kreis ausgeblendet). -->
    <Style Selector="RadioButton.chip-filter">
      <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource KrosteSecondaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.chip-filter:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource KrosteTextBrush}" />
    </Style>
    <Style Selector="RadioButton.chip-filter:checked">
      <Setter Property="Background" Value="{DynamicResource KrosteAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteAccentBrush}" />
      <Setter Property="Foreground" Value="#F5F7FA" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ================================================================== -->
    <!-- Cards / Sektionen                                                   -->
    <!-- ================================================================== -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource KrosteCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.card-flat">
      <Setter Property="Background" Value="{DynamicResource KrosteCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Host-Karte in der Ergebnisliste: Card mit Hover- und Auswahl-State. -->
    <Style Selector="Border.host-card">
      <Setter Property="Background" Value="{DynamicResource KrosteCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.host-card:pointerover">
      <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderStrongBrush}" />
    </Style>

    <!-- Kleiner Chip für offene Ports / Dienste. -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource KrosteBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <!-- ================================================================== -->
    <!-- Text-Rollen                                                         -->
    <!-- ================================================================== -->
    <Style Selector="TextBlock.h1">
      <Setter Property="Foreground" Value="{DynamicResource KrosteGoldBrush}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="Foreground" Value="{DynamicResource KrosteGoldBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section-label">
      <Setter Property="Foreground" Value="{DynamicResource KrosteMutedTextBrush}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource KrosteMutedTextBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource KrosteSecondaryTextBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Code,JetBrains Mono,Consolas,Menlo,monospace" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Cascadia Code,JetBrains Mono,Consolas,Menlo,monospace" />
    </Style>

    <!-- ================================================================== -->
    <!-- TextBox / ComboBox / CheckBox — Fokus-Ring in Gold                   -->
    <!-- ================================================================== -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource KrosteTextBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource KrosteGoldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderStrongBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteGoldBrush}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource KrosteTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteGoldBrush}" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource KrosteSecondaryTextBrush}" />
    </Style>

    <!-- ================================================================== -->
    <!-- ProgressBar — dünn, Gold                                            -->
    <!-- ================================================================== -->
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource KrosteGoldBrush}" />
      <Setter Property="Background" Value="#2A2F36" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!-- ================================================================== -->
    <!-- ListBox — das Item-Chrome übernimmt die Host-Karte selbst            -->
    <!-- ================================================================== -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.host-card">
      <Setter Property="Background" Value="{DynamicResource KrosteAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KrosteGoldBrush}" />
    </Style>

    <!-- ================================================================== -->
    <!-- Divider                                                             -->
    <!-- ================================================================== -->
    <Style Selector="Rectangle.divider-v">
      <Setter Property="Width" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource KrosteBorderBrush}" />
      <Setter Property="Margin" Value="6,4" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Rectangle.divider-h">
      <Setter Property="Height" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource KrosteBorderBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Application.Styles>
</Application>
