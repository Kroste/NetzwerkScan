<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\netscanner.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>NetScanner</AssemblyName>
    <RootNamespace>NetScanner</RootNamespace>
    <!-- Version kommt aus dem Git-Tag (MinVer, Präfix "v"). Kein manuelles
         Hochzählen mehr — ein Tag vX.Y.Z ist die einzige Versionsquelle. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- UI -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- DevTools (F12). In Avalonia 12 wurde Avalonia.Diagnostics entfernt und durch
         AvaloniaUI.DiagnosticsSupport ersetzt. Nur im Debug-Build. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport"
                      Condition="'$(Configuration)' == 'Debug'" />
    <!-- Explizit, damit die DBus-Version für den Linux-Tray nicht driftet. -->
    <PackageReference Include="Tmds.DBus.Protocol" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" />

    <!-- DI + Logging -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="NLog" />
    <PackageReference Include="NLog.Extensions.Logging" />

    <!-- Kamera-Vorschau: KEIN eingebettetes LibVLC (Airspace + libvlc-Deployment-Hölle
         auf Linux/AppImage, siehe kroste-avalonia/references/media-preview.md). Die
         Vorschau ist ein ffmpeg-Frame-Grab (MediaPreviewService), echtes Live-Video
         läuft im externen Player. ffmpeg ist eine Laufzeit-Abhängigkeit, kein NuGet-Paket. -->
    <!-- Microsoft.Win32.Registry: KEIN PackageReference nötig. Die Typen liegen seit
         .NET 5 im Framework selbst; das Kompatibilitäts-Paket löst nur NU1510 aus
         ("wird nicht gekuerzt"), was mit TreatWarningsAsErrors den Build bricht.
         Der Zugriff in VlcLocator ist ohnehin mit [SupportedOSPlatform("windows")]
         abgesichert. -->
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <None Update="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Testprojekt darf auf internal-Typen zugreifen (Masking-Renderer, Helfer). -->
  <ItemGroup>
    <InternalsVisibleTo Include="NetScanner.Tests" />
  </ItemGroup>

</Project>
