<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NetScanner.Localization"
        xmlns:ctrl="using:NetScanner.Controls"
        xmlns:views="using:NetScanner.Views"
        x:Class="NetScanner.Views.AboutWindow"
        Width="460" Height="520" MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource KrosteBackgroundBrush}"
        Title="{loc:Tr Window_About}">

  <Grid RowDefinitions="Auto,*">

    <ctrl:TitleBar Grid.Row="0" Title="{loc:Tr Window_About}"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,20,24,24" Spacing="16">

        <!-- Kopf: Marke + Version -->
        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" Margin="0,4,0,0">
          <Panel Width="44" Height="44">
            <Ellipse Width="44" Height="44" Stroke="{DynamicResource KrosteGoldBrush}" StrokeThickness="1.5" Opacity="0.3"/>
            <Ellipse Width="30" Height="30" Stroke="{DynamicResource KrosteGoldBrush}" StrokeThickness="1.5" Opacity="0.6"/>
            <Ellipse Width="9"  Height="9"  Fill="{DynamicResource KrosteGoldBrush}"/>
          </Panel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="NetScanner" Classes="h1"/>
            <TextBlock x:Name="VersionText" Classes="muted" FontSize="12"
                       Text="Version … · .NET 10 · Avalonia 12"/>
          </StackPanel>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Classes="secondary"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Text="{loc:Tr About_Tagline}"/>

        <!-- Aktualisierung -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:Tr About_Section_Update}" Classes="section-label"/>
            <TextBlock x:Name="UpdateStatus" Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:Tr About_NotChecked}"/>
            <ProgressBar x:Name="UpdateProgress" IsVisible="False" Minimum="0" Maximum="100"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="CheckUpdateButton" Content="{loc:Tr About_CheckUpdate}" Click="OnCheckUpdateClick"/>
              <Button x:Name="InstallUpdateButton" Classes="accent" Content="{loc:Tr About_InstallUpdate}"
                      IsVisible="False" Click="OnInstallUpdateClick"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Projekt -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:Tr About_Section_Project}" Classes="section-label"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{loc:Tr About_SourceCode}" FontSize="13" Classes="muted" VerticalAlignment="Center"/>
              <Button Classes="link" Content="github.com/Kroste/NetzwerkScan" Click="OnGitHubClick"/>
            </StackPanel>
            <TextBlock Text="{loc:Tr About_LikeIt}" FontSize="13" Classes="secondary"/>
            <Button Classes="coffee" Content="{loc:Tr About_Coffee}" HorizontalAlignment="Stretch"
                    Click="OnCoffeeClick"/>
          </StackPanel>
        </Border>

        <Button Content="{loc:Tr Common_Close}" HorizontalAlignment="Stretch" Click="OnCloseClick"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</views:ChromeWindow>
