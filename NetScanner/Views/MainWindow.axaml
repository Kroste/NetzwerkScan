<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NetScanner.Localization"
        xmlns:vm="using:NetScanner.ViewModels"
        xmlns:models="using:NetScanner.Models"
        xmlns:ctrl="using:NetScanner.Controls"
        xmlns:views="using:NetScanner.Views"
        x:Class="NetScanner.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource KrosteBackgroundBrush}"
        Title="{loc:Tr Window_Main}">


  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- ===== Titelleiste (Kroste-Chrome) ===== -->
    <ctrl:TitleBar Grid.Row="0" Title="{loc:Tr Window_Main}">
      <ctrl:TitleBar.Actions>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

          <!-- Zähler: hit-test-transparent, damit der Drag durchfällt -->
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center"
                      IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding HostCount}" FontSize="16" FontWeight="Bold"
                         Foreground="{DynamicResource KrosteTextBrush}"/>
              <TextBlock Text="{loc:Tr Main_Hosts}" FontSize="12" VerticalAlignment="Center" Classes="muted"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding CameraCount}" FontSize="16" FontWeight="Bold"
                         Foreground="{DynamicResource NetCameraBrush}"/>
              <TextBlock Text="{loc:Tr Main_Cameras}" FontSize="12" VerticalAlignment="Center" Opacity="0.85"
                         Foreground="{DynamicResource NetCameraBrush}"/>
            </StackPanel>
          </StackPanel>

          <Rectangle Classes="divider-v" Height="22"/>

          <Button Classes="icon" Click="OnMapClick" ToolTip.Tip="{loc:Tr Main_Map_Tip}">
            <Canvas Width="18" Height="18">
              <Line StartPoint="9,9" EndPoint="3.5,4.5" Stroke="{DynamicResource KrosteMutedTextBrush}" StrokeThickness="1.2"/>
              <Line StartPoint="9,9" EndPoint="14.5,5"  Stroke="{DynamicResource KrosteMutedTextBrush}" StrokeThickness="1.2"/>
              <Line StartPoint="9,9" EndPoint="9,15.5"  Stroke="{DynamicResource KrosteMutedTextBrush}" StrokeThickness="1.2"/>
              <Ellipse Canvas.Left="6"  Canvas.Top="6"  Width="6" Height="6" Fill="{DynamicResource KrosteGoldBrush}"/>
              <Ellipse Canvas.Left="1.5" Canvas.Top="2.5" Width="4" Height="4" Fill="{DynamicResource KrosteMutedTextBrush}"/>
              <Ellipse Canvas.Left="13" Canvas.Top="3"  Width="4" Height="4" Fill="{DynamicResource KrosteMutedTextBrush}"/>
              <Ellipse Canvas.Left="7"  Canvas.Top="14" Width="4" Height="4" Fill="{DynamicResource KrosteMutedTextBrush}"/>
            </Canvas>
          </Button>

          <Button Classes="icon" Click="OnPwCheckClick" ToolTip.Tip="{loc:Tr Main_PwCheck_Tip}">
            <Canvas Width="18" Height="18">
              <Path Data="M9,1.5 L15.5,3.8 L15.5,9 C15.5,13 12.7,15.6 9,16.8 C5.3,15.6 2.5,13 2.5,9 L2.5,3.8 Z"
                    Stroke="{DynamicResource KrosteMutedTextBrush}" StrokeThickness="1.3"/>
              <Path Data="M6,9 L8,11 L12,6.5" Stroke="{DynamicResource KrosteGoldBrush}" StrokeThickness="1.5"/>
            </Canvas>
          </Button>

          <Button Classes="icon" Click="OnExposureClick" ToolTip.Tip="{loc:Tr Main_Exposure_Tip}">
            <Canvas Width="18" Height="18">
              <Ellipse Canvas.Left="2" Canvas.Top="2" Width="14" Height="14"
                       Stroke="{DynamicResource KrosteMutedTextBrush}" StrokeThickness="1.3"/>
              <Ellipse Canvas.Left="6" Canvas.Top="2" Width="6" Height="14"
                       Stroke="{DynamicResource KrosteMutedTextBrush}" StrokeThickness="1.1"/>
              <Line StartPoint="2.2,9" EndPoint="15.8,9" Stroke="{DynamicResource KrosteMutedTextBrush}" StrokeThickness="1.1"/>
            </Canvas>
          </Button>

          <!-- Erscheint nur, wenn der Start-Check ein Update gefunden hat. -->
          <Button x:Name="UpdateBadge" Classes="accent" Content="{loc:Tr Main_Update}" IsVisible="False"
                  Click="OnAboutClick" ToolTip.Tip="{loc:Tr Main_Update_Tip}"/>

          <Button Classes="icon" Click="OnSettingsClick" ToolTip.Tip="{loc:Tr Settings_Open_Tip}">
            <TextBlock Text="⚙" FontSize="16"/>
          </Button>

          <Button Classes="icon" Click="OnAboutClick" ToolTip.Tip="{loc:Tr Main_About_Tip}">
            <TextBlock Text="i" FontFamily="Georgia,Cambria,serif" FontSize="16" FontWeight="Bold"/>
          </Button>
        </StackPanel>
      </ctrl:TitleBar.Actions>
    </ctrl:TitleBar>

    <!-- ===== Steuerleiste ===== -->
    <Border Grid.Row="1" Classes="card" Margin="20,16,20,0">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Main_Section_Cidr}" Classes="section-label"/>
            <TextBox Classes="mono" Text="{Binding Cidr}" Width="210" PlaceholderText="{loc:Tr Main_Cidr_Placeholder}"/>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Main_Section_OnvifWait}" Classes="section-label"/>
            <NumericUpDown Value="{Binding OnvifListenMs}" Minimum="500" Maximum="10000"
                           Increment="500" Width="130" Height="36"/>
          </StackPanel>
          <StackPanel Spacing="8" VerticalAlignment="Bottom" Margin="6,0,0,6">
            <CheckBox Content="{loc:Tr Main_AllPorts}" IsChecked="{Binding ScanFullPorts}"/>
            <CheckBox Content="{loc:Tr Main_ProbeRtsp}" IsChecked="{Binding ProbeRtsp}"/>
            <CheckBox Content="{loc:Tr Main_AuditCredentials}" IsChecked="{Binding AuditCredentials}"
                      ToolTip.Tip="{loc:Tr Main_AuditCredentials_Tip}"/>
          </StackPanel>
        </StackPanel>

        <Rectangle Classes="divider-h"/>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Main_Section_RtspLogin}" Classes="section-label"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding RtspUser}" Width="150" PlaceholderText="{loc:Tr Main_User_Placeholder}"/>
              <TextBox Text="{Binding RtspPass}" Width="150" PlaceholderText="{loc:Tr Main_Password_Placeholder}" PasswordChar="•"/>
            </StackPanel>
          </StackPanel>

          <Button Classes="accent" Content="{loc:Tr Main_StartScan}" VerticalAlignment="Bottom"
                  Command="{Binding StartScanCommand}" IsEnabled="{Binding !IsScanning}"/>
          <Button Classes="ghost" Content="{loc:Tr Common_Cancel}" VerticalAlignment="Bottom"
                  Command="{Binding CancelScanCommand}" IsEnabled="{Binding IsScanning}"/>
          <ProgressBar IsIndeterminate="{Binding IsScanning}" IsVisible="{Binding IsScanning}"
                       Width="160" Height="4" VerticalAlignment="Bottom" Margin="4,0,0,16"
                       Foreground="{DynamicResource KrosteGoldBrush}"/>

          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Margin="8,0,0,0">
            <Button Classes="ghost" Content="{loc:Tr Main_ExportCsv}" Click="OnExportCsv" ToolTip.Tip="{loc:Tr Main_ExportCsv_Tip}"/>
            <Button Classes="ghost" Content="{loc:Tr Main_ExportJson}" Click="OnExportJson" ToolTip.Tip="{loc:Tr Main_ExportJson_Tip}"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ===== Inhalt: Liste | Video ===== -->
    <Grid Grid.Row="2" Margin="20,16,20,0" ColumnDefinitions="*,12,1.05*">

      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
        <ListBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:HostResult">
              <Border Classes="host-card" Padding="0" PointerReleased="OnCardPointerReleased">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{loc:Tr Main_Ctx_OpenWeb}" Click="OnHostWeb" IsVisible="{Binding HasWebUi}"/>
                    <MenuItem Header="{loc:Tr Main_Ctx_Ssh}" Click="OnHostSsh" IsVisible="{Binding HasSsh}"/>
                    <MenuItem Header="{loc:Tr Main_Ctx_Rdp}" Click="OnHostRdp" IsVisible="{Binding HasRdp}"/>
                    <MenuItem Header="{loc:Tr Main_Ctx_Smb}" Click="OnHostSmb" IsVisible="{Binding HasSmb}"/>
                    <Separator/>
                    <MenuItem Header="{loc:Tr Common_CopyIp}" Click="OnHostCopyIp"/>
                    <MenuItem Header="{loc:Tr Common_CopyMac}" Click="OnHostCopyMac" IsVisible="{Binding HasMac}"/>
                    <MenuItem Header="{loc:Tr Common_CopyName}" Click="OnHostCopyName" IsVisible="{Binding HasBestName}"/>
                    <Separator/>
                    <MenuItem Header="{loc:Tr Main_Ctx_Wol}" Click="OnHostWol" IsVisible="{Binding HasMac}"/>
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="3,16,Auto,*,Auto">

                  <!-- Kamera-Akzentstreifen (Spalte immer 3px -> kein Layout-Shift) -->
                  <Border Grid.Column="0" Background="{DynamicResource NetCameraBrush}"
                          CornerRadius="10,0,0,10" IsVisible="{Binding IsCamera}"/>

                  <!-- Status-Punkt: Teal=ICMP, Gelb=nur ARP -->
                  <Panel Grid.Column="2" VerticalAlignment="Center" Width="12" Height="12">
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource NetOnlineBrush}"
                             IsVisible="{Binding IsIcmpAlive}"/>
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource NetArpOnlyBrush}"
                             IsVisible="{Binding !IsIcmpAlive}"/>
                  </Panel>

                  <!-- Infoblock -->
                  <StackPanel Grid.Column="3" Spacing="5" Margin="14,12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Address}" FontWeight="Bold" FontSize="15"
                                 FontFamily="Cascadia Code,JetBrains Mono,Consolas,monospace"
                                 Foreground="{DynamicResource KrosteTextBrush}"/>
                      <Border Background="{DynamicResource NetCameraSoftBrush}" CornerRadius="4" Padding="6,1"
                              VerticalAlignment="Center" IsVisible="{Binding IsCamera}">
                        <TextBlock Text="{loc:Tr Main_Camera}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource NetCameraBrush}"/>
                      </Border>
                      <Border Background="{DynamicResource NetVulnSoftBrush}" CornerRadius="4" Padding="6,1"
                              VerticalAlignment="Center" IsVisible="{Binding IsVulnerable}">
                        <TextBlock Text="{loc:Tr Main_Open}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NetVulnBrush}"/>
                      </Border>
                      <TextBlock Text="{Binding Vendor}" FontSize="12" VerticalAlignment="Center"
                                 Foreground="{DynamicResource KrosteMutedTextBrush}"/>
                      <TextBlock Text="{Binding LatencyDisplay}" FontSize="11" VerticalAlignment="Center"
                                 Foreground="{DynamicResource KrosteMutedTextBrush}"/>
                    </StackPanel>

                    <!-- Gerätetyp + OS -->
                    <Border Background="{DynamicResource KrosteAccentSoftBrush}" CornerRadius="4" Padding="7,2"
                            HorizontalAlignment="Left" IsVisible="{Binding HasDeviceInfo}">
                      <TextBlock Text="{Binding DeviceSummary}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource KrosteGoldBrush}"/>
                    </Border>

                    <TextBlock Text="{Binding BestName}" FontSize="12" IsVisible="{Binding HasBestName}"
                               Foreground="{DynamicResource KrosteMutedTextBrush}"/>

                    <TextBlock Text="{Binding DiscoveryDisplay}" FontSize="11" IsVisible="{Binding HasDiscovery}"
                               Foreground="{DynamicResource KrosteGoldBrush}" Opacity="0.85"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding BannerDisplay}" FontSize="11" IsVisible="{Binding HasBanner}"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               Foreground="{DynamicResource KrosteMutedTextBrush}" Opacity="0.8"
                               TextTrimming="CharacterEllipsis"/>

                    <ItemsControl ItemsSource="{Binding OpenPorts}" Margin="0,2,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PortResult">
                          <Border Classes="chip">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <TextBlock Text="{Binding Port}" FontSize="11" FontWeight="SemiBold"
                                         FontFamily="Cascadia Code,Consolas,monospace"
                                         Foreground="{DynamicResource KrosteTextBrush}"/>
                              <TextBlock Text="{Binding Service}" FontSize="11"
                                         Foreground="{DynamicResource KrosteMutedTextBrush}"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding MacAddress}" FontSize="11" IsVisible="{Binding HasMac}"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               Foreground="{DynamicResource KrosteMutedTextBrush}" Opacity="0.7"/>
                  </StackPanel>

                  <!-- Stream-Aktion -->
                  <Button Grid.Column="4" Classes="stream" Content="{loc:Tr Main_Stream}"
                          VerticalAlignment="Center" Margin="0,0,14,0"
                          IsVisible="{Binding IsCamera}"
                          Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenStreamCommand}"
                          CommandParameter="{Binding}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>

      <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

      <Grid Grid.Column="2" RowDefinitions="*,Auto">

        <!-- ===== Detail-Panel ===== -->
        <Border Grid.Row="0" Classes="card-flat" ClipToBounds="True">
          <Panel>
            <!-- Platzhalter -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        IsVisible="{Binding SelectedHost, Converter={x:Static ObjectConverters.IsNull}}">
              <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource KrosteSurfaceBrush}"
                      HorizontalAlignment="Center">
                <TextBlock Text="◉" FontSize="26" Foreground="{DynamicResource KrosteMutedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="{loc:Tr Main_SelectHost}" Foreground="{DynamicResource KrosteMutedTextBrush}"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="{loc:Tr Main_RightClickHint}" FontSize="12"
                         Foreground="{DynamicResource KrosteMutedTextBrush}" Opacity="0.6"
                         HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Detailinhalt -->
            <ScrollViewer IsVisible="{Binding SelectedHost, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel DataContext="{Binding SelectedHost}" Margin="18" Spacing="13">

                <!-- Kopf: IP + Kamera-Badge -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Address}" FontSize="20" FontWeight="Bold"
                             FontFamily="Cascadia Code,JetBrains Mono,Consolas,monospace"
                             Foreground="{DynamicResource KrosteTextBrush}"/>
                  <Border Background="{DynamicResource NetCameraSoftBrush}" CornerRadius="4" Padding="6,1"
                          VerticalAlignment="Center" IsVisible="{Binding IsCamera}">
                    <TextBlock Text="{loc:Tr Main_Camera}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource NetCameraBrush}"/>
                  </Border>
                </StackPanel>

                <!-- Geräte-Badge -->
                <Border Background="{DynamicResource KrosteAccentSoftBrush}" CornerRadius="4" Padding="8,3"
                        HorizontalAlignment="Left" IsVisible="{Binding HasDeviceInfo}">
                  <TextBlock Text="{Binding DeviceSummary}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource KrosteGoldBrush}"/>
                </Border>

                <!-- Aktionen -->
                <WrapPanel>
                  <Button Classes="ghost" Content="{loc:Tr Main_Btn_Web}" Click="OnHostWeb" Margin="0,0,6,6"
                          IsVisible="{Binding HasWebUi}"/>
                  <Button Classes="ghost" Content="{loc:Tr Main_Btn_Ssh}" Click="OnHostSsh" Margin="0,0,6,6"
                          IsVisible="{Binding HasSsh}"/>
                  <Button Classes="ghost" Content="{loc:Tr Main_Btn_Rdp}" Click="OnHostRdp" Margin="0,0,6,6"
                          IsVisible="{Binding HasRdp}"/>
                  <Button Classes="ghost" Content="{loc:Tr Main_Btn_Smb}" Click="OnHostSmb" Margin="0,0,6,6"
                          IsVisible="{Binding HasSmb}"/>
                  <Button Classes="ghost" Content="{loc:Tr Main_Btn_Wol}" Click="OnHostWol" Margin="0,0,6,6"
                          IsVisible="{Binding HasMac}"/>
                </WrapPanel>

                <Rectangle Classes="divider-h"/>

                <!-- Eigenschaften -->
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="88,*" IsVisible="{Binding HasBestName}">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Main_Name}" FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding BestName}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource KrosteTextBrush}"/>
                  </Grid>
                  <Grid ColumnDefinitions="88,*" IsVisible="{Binding Vendor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Main_Vendor}" FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Vendor}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource KrosteTextBrush}"/>
                  </Grid>
                  <Grid ColumnDefinitions="88,*" IsVisible="{Binding HasMac}">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Main_Mac}" FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding MacAddress}" FontSize="12"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               Foreground="{DynamicResource KrosteTextBrush}"/>
                  </Grid>
                  <Grid ColumnDefinitions="88,*" IsVisible="{Binding Ttl, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Main_Ttl}" FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Ttl}" FontSize="12"
                               Foreground="{DynamicResource KrosteTextBrush}"/>
                  </Grid>
                  <Grid ColumnDefinitions="88,*">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Main_Latency}" FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding LatencyDisplay}" FontSize="12"
                               Foreground="{DynamicResource KrosteTextBrush}"/>
                  </Grid>
                </StackPanel>

                <!-- Discovery -->
                <StackPanel Spacing="7" IsVisible="{Binding HasDiscovery}">
                  <Rectangle Classes="divider-h"/>
                  <TextBlock Text="{loc:Tr Main_Discovery}" Classes="section-label"/>
                  <TextBlock Text="{Binding DiscoveryDisplay}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource KrosteGoldBrush}"/>
                  <TextBlock Text="{Binding UpnpServer}" FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource KrosteMutedTextBrush}"
                             IsVisible="{Binding UpnpServer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- Banner -->
                <StackPanel Spacing="6" IsVisible="{Binding HasBanner}">
                  <Rectangle Classes="divider-h"/>
                  <TextBlock Text="{Binding BannerDisplay}" FontSize="11" TextWrapping="Wrap"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             Foreground="{DynamicResource KrosteMutedTextBrush}"/>
                </StackPanel>

                <!-- Ports -->
                <StackPanel Spacing="7">
                  <Rectangle Classes="divider-h"/>
                  <TextBlock Text="{loc:Tr Main_OpenPorts}" Classes="section-label"/>
                  <ItemsControl ItemsSource="{Binding OpenPorts}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:PortResult">
                        <Border Classes="chip">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding Port}" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="Cascadia Code,Consolas,monospace"
                                       Foreground="{DynamicResource KrosteTextBrush}"/>
                            <TextBlock Text="{Binding Service}" FontSize="11"
                                       Foreground="{DynamicResource KrosteMutedTextBrush}"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Schwachstellen-Befund (nur bei Audit-Fund) -->
                <Border Background="{DynamicResource NetVulnSoftBrush}" BorderBrush="{DynamicResource NetVulnBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,9" IsVisible="{Binding HasVulnBadge}">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{loc:Tr Main_Vulnerability}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource NetVulnBrush}"/>
                    <TextBlock Text="{Binding VulnBadge}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource KrosteTextBrush}"/>
                  </StackPanel>
                </Border>

                <!-- Kamera-Stream -->
                <StackPanel Spacing="8" IsVisible="{Binding IsCamera}">
                  <Rectangle Classes="divider-h"/>
                  <TextBlock Text="{Binding RtspUri}" FontSize="11" TextWrapping="Wrap"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             Foreground="{DynamicResource KrosteMutedTextBrush}"
                             IsVisible="{Binding HasRtspUri}"/>
                  <Button Classes="stream" Content="{loc:Tr Main_OpenStream}" HorizontalAlignment="Left"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenStreamCommand}"
                          CommandParameter="{Binding}"/>
                </StackPanel>

                <!-- Kopier-Aktionen -->
                <WrapPanel Margin="0,2,0,0">
                  <Button Classes="ghost" Content="{loc:Tr Common_CopyIp}" Click="OnHostCopyIp" Margin="0,0,6,6"/>
                  <Button Classes="ghost" Content="{loc:Tr Common_CopyMac}" Click="OnHostCopyMac" Margin="0,0,6,6"
                          IsVisible="{Binding HasMac}"/>
                </WrapPanel>

              </StackPanel>
            </ScrollViewer>
          </Panel>
        </Border>

        <!-- ===== Video (nur bei aktivem Stream UND verfügbarem libvlc) ===== -->
        <!-- Die Statuszeile liegt UNTER dem Video, nicht darüber: NativeControlHost ist
             ein natives Fenster und wuerde ein Avalonia-Overlay verdecken (Airspace). -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0" IsVisible="{Binding ShowVideoPreview}">
          <Border Height="232" CornerRadius="8,8,0,0" Background="{DynamicResource NetVideoBackgroundBrush}"
                  BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1" ClipToBounds="True">
            <ctrl:NativeVideoView x:Name="VideoView" MediaUrl="{Binding SelectedStreamUrl}"/>
          </Border>
          <Border Background="{DynamicResource KrosteSurfaceBrush}" Padding="12,6" CornerRadius="0,0,8,8"
                  BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1,0,1,1"
                  IsVisible="{Binding #VideoView.PlaybackInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding #VideoView.PlaybackInfo}" Foreground="{DynamicResource KrosteMutedTextBrush}"
                       FontFamily="Cascadia Code,Consolas,monospace" FontSize="12"/>
          </Border>
        </StackPanel>

        <!-- ===== Hinweis, wenn kein (passendes) VLC installiert ist ===== -->
        <Border Grid.Row="1" Height="260" Margin="0,12,0,0" Classes="card-flat"
                Background="{DynamicResource NetVideoBackgroundBrush}" ClipToBounds="True"
                IsVisible="{Binding ShowVlcMissingHint}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="24">
            <TextBlock Text="{loc:Tr Main_VlcRequired}"
                       Foreground="{DynamicResource KrosteTextBrush}" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" MaxWidth="430"
                       Foreground="{DynamicResource KrosteMutedTextBrush}" FontSize="12"
                       Text="{Binding VlcHintText}"/>
            <Button Classes="stream" Content="{loc:Tr Main_DownloadVlc}" HorizontalAlignment="Center"
                    Click="OnDownloadVlc"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ===== Statusleiste ===== -->
    <Border Grid.Row="3" Padding="20,10" Margin="0,16,0,0"
            Background="{DynamicResource KrosteTitleBarBrush}"
            BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                 Fill="{DynamicResource KrosteGoldBrush}" IsVisible="{Binding IsScanning}"/>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource KrosteMutedTextBrush}"
                   FontFamily="Cascadia Code,Consolas,monospace" FontSize="12"
                   VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</views:ChromeWindow>
