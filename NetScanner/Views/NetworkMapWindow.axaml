<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NetScanner.Localization"
        xmlns:ctrl="using:NetScanner.Controls"
        xmlns:views="using:NetScanner.Views"
        x:Class="NetScanner.Views.NetworkMapWindow"
        Width="940" Height="700" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource KrosteBackgroundBrush}"
        Title="{loc:Tr Main_Map_Tip}">


  <Grid RowDefinitions="Auto,*,Auto">

    <ctrl:TitleBar Grid.Row="0" Title="{loc:Tr Window_Map}"/>

    <!-- ===== Karte (Canvas) + Legende ===== -->
    <Panel Grid.Row="1" ClipToBounds="True">
      <Canvas x:Name="MapCanvas" Background="{DynamicResource KrosteBackgroundBrush}"/>

      <!-- leerer Zustand -->
      <TextBlock x:Name="EmptyHint" IsVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="14" Foreground="{DynamicResource KrosteMutedTextBrush}"
                 Text="{loc:Tr Map_NoHosts}"/>

      <!-- Legende -->
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
              Background="{DynamicResource KrosteCardBrush}" BorderBrush="{DynamicResource KrosteBorderBrush}"
              BorderThickness="1" CornerRadius="9" Padding="12,9">
        <StackPanel x:Name="LegendPanel" Spacing="5"/>
      </Border>
    </Panel>

    <!-- ===== Traceroute-Leiste ===== -->
    <Border Grid.Row="2" Background="{DynamicResource KrosteCardBrush}"
            BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0"
            Padding="16,12">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" >
          <TextBlock Grid.Column="0" Text="{loc:Tr Map_TraceLabel}" VerticalAlignment="Center"
                     FontSize="13" FontWeight="Bold" Foreground="{DynamicResource KrosteTextBrush}"
                     Margin="0,0,14,0"/>
          <TextBox Grid.Column="1" x:Name="TraceTarget" Classes="mono"
                   PlaceholderText="{loc:Tr Map_TracePlaceholder}" Text="8.8.8.8"/>
          <Button Grid.Column="2" x:Name="TraceBtn" Classes="accent" Content="{loc:Tr Map_TraceStart}"
                  Click="OnTrace" Margin="10,0,0,0"/>
          <Button Grid.Column="3" x:Name="TraceCancelBtn" Classes="ghost" Content="{loc:Tr Common_Cancel}"
                  Click="OnTraceCancel" IsVisible="False" Margin="8,0,0,0"/>
          <Button Grid.Column="4" Classes="ghost" Content="{loc:Tr Common_Refresh}"
                  Click="OnRefresh" Margin="8,0,0,0" ToolTip.Tip="{loc:Tr Map_Refresh_Tip}"/>
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="HopPanel" Orientation="Horizontal" Spacing="0" MinHeight="44"/>
        </ScrollViewer>

        <TextBlock x:Name="TraceStatus" FontSize="12" Foreground="{DynamicResource KrosteMutedTextBrush}"
                   Text="{loc:Tr Map_TraceHint}"/>
      </StackPanel>
    </Border>
  </Grid>
</views:ChromeWindow>
