<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NetScanner.Localization"
        xmlns:ctrl="using:NetScanner.Controls"
        xmlns:views="using:NetScanner.Views"
        x:Class="NetScanner.Views.PasswordCheckWindow"
        Width="480" Height="560" MinWidth="360" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource KrosteBackgroundBrush}"
        Title="{loc:Tr Main_PwCheck_Tip}">


  <Grid RowDefinitions="Auto,*">

    <ctrl:TitleBar Grid.Row="0" Title="{loc:Tr Window_PwCheck}"/>

    <!-- ===== Inhalt ===== -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,22,28,24" Spacing="16">

      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Tr Pw_Heading}" FontSize="19" FontWeight="Bold"
                   Foreground="{DynamicResource KrosteTextBrush}"/>
        <TextBlock Text="{loc:Tr Pw_Intro}"
                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource KrosteMutedTextBrush}"/>
      </StackPanel>

      <!-- Datenschutz-/Transparenzhinweis -->
      <Border Background="{DynamicResource KrosteCardBrush}" BorderBrush="{DynamicResource KrosteBorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="14,12">
        <StackPanel Spacing="7">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Text="🔒" FontSize="13"/>
            <TextBlock Text="{loc:Tr Pw_StaysLocal}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource KrosteTextBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="11" LineHeight="17"
                     Foreground="{DynamicResource KrosteMutedTextBrush}"
                     Text="{loc:Tr Pw_Method}"/>
        </StackPanel>
      </Border>

      <!-- Eingabe -->
      <StackPanel Spacing="8">
        <TextBlock Text="{loc:Tr Pw_Section}" FontSize="10" FontWeight="SemiBold"
                   Foreground="{DynamicResource KrosteMutedTextBrush}"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="PwBox" Grid.Column="0" PasswordChar="•" Height="42"
                   FontSize="14" PlaceholderText="{loc:Tr Pw_Placeholder}"
                   KeyDown="OnPwKeyDown"/>
          <ToggleButton x:Name="RevealToggle" Grid.Column="1" Content="👁" Width="46" Height="42"
                        FontSize="15" ToolTip.Tip="{loc:Tr Pw_Reveal_Tip}"
                        IsCheckedChanged="OnRevealChanged"/>
        </Grid>
      </StackPanel>

      <Button x:Name="CheckBtn" Classes="accent" Content="{loc:Tr Common_Check}" Click="OnCheckClick"/>

      <!-- Passwortstärke (lokal, sofort) -->
      <Border x:Name="StrengthBox" IsVisible="False" Background="{DynamicResource KrosteCardBrush}"
              BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
        <StackPanel Spacing="9">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Tr Pw_Strength}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource KrosteMutedTextBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StrengthLabel" Grid.Column="1" FontSize="12" FontWeight="Bold"/>
          </Grid>
          <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4" Height="6">
            <Border x:Name="Seg0" Grid.Column="0" CornerRadius="3" Background="{DynamicResource KrosteBorderBrush}"/>
            <Border x:Name="Seg1" Grid.Column="1" CornerRadius="3" Background="{DynamicResource KrosteBorderBrush}"/>
            <Border x:Name="Seg2" Grid.Column="2" CornerRadius="3" Background="{DynamicResource KrosteBorderBrush}"/>
            <Border x:Name="Seg3" Grid.Column="3" CornerRadius="3" Background="{DynamicResource KrosteBorderBrush}"/>
            <Border x:Name="Seg4" Grid.Column="4" CornerRadius="3" Background="{DynamicResource KrosteBorderBrush}"/>
          </Grid>
          <StackPanel Spacing="3" Margin="0,2,0,0">
            <TextBlock x:Name="CrackFast" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource KrosteTextBrush}"/>
            <TextBlock x:Name="CrackSlow" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource KrosteMutedTextBrush}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Ergebnis Leak-Check -->
      <Border x:Name="ResultBox" IsVisible="False" BorderThickness="1" CornerRadius="10" Padding="14,12">
        <StackPanel Spacing="4">
          <TextBlock x:Name="ResultTitle" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock x:Name="ResultDetail" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource KrosteMutedTextBrush}"/>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
        <TextBlock Text="{loc:Tr Pw_Source}" FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}"
                   VerticalAlignment="Center"/>
        <Button Classes="link" Content="haveibeenpwned.com/Passwords" Click="OnHibpClick"/>
      </StackPanel>

      <Button Classes="close" Content="{loc:Tr Common_Close}" Click="OnCloseClick"/>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</views:ChromeWindow>
