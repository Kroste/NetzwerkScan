#!/bin/bash
# Einstiegspunkt der AppImage. $APPDIR zeigt auf das entpackte Image.
HERE="$(dirname "$(readlink -f "${0}")")"
APP="${HERE}/usr/bin"

# Die Kamera-Vorschau nutzt System-ffmpeg (kein Bundling). Fehlt es, zeigt die
# App einen Hinweis; der externe Player braucht ohnehin nur eine rtsp://-Assoziation.
exec "${APP}/NetScanner" "$@"
